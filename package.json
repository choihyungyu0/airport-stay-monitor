{
  "name": "airport-stay-monitor",
  "private": true,
  "version": "1.0.0",
  "description": "공항 체류전환 모니터 — 지방공항 외래객의 권역 체류·소비를 국적별로 산출하는 웹",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:data": "python scripts/build_data.py",
    "check:data": "python scripts/build_data.py --check",
    "verify": "node scripts/check_report.mjs",
    "test": "npm run test:py && npm run test:web",
    "test:py": "python -m pytest -q",
    "test:web": "vitest run",
    "typecheck": "tsc -b",
    "build": "node scripts/check_report.mjs && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
